+
+package com.metrolist.music.telegram
+
+import android.content.Context
+import androidx.media3.common.Player
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import org.drinkless.tdlib.TdApi
+import java.io.File
+import java.util.concurrent.ConcurrentHashMap
+
+/** The downloadable file behind a Telegram message (audio message or plain document). */
+internal fun telegramFileOf(msg: TdApi.Message): TdApi.File? =
+    when (val c = msg.content) {
+        is TdApi.MessageAudio -> c.audio.audio
+        is TdApi.MessageDocument -> c.document.document
+        else -> null
+    }
+
+/**
+ * Spotify-style offline downloads. A downloaded song is a full copy in the app's own
+ * folder, so it plays with no internet and is never touched by cache cleanup.
+ */
+object TelegramOffline {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val gate = Semaphore(2)
+    private val jobs = ConcurrentHashMap<String, Job>()
+    private var dir: File? = null
+
+    private val _ids = MutableStateFlow<Set<String>>(emptySet())
+    /** Ids of songs that are fully downloaded. */
+    val offlineIds: StateFlow<Set<String>> = _ids
+
+    private val _active = MutableStateFlow<Map<String, Int>>(emptyMap())
+    /** Songs being downloaded: id -> percent (-1 = waiting in line). */
+    val active: StateFlow<Map<String, Int>> = _active
+
+    private val _bytes = MutableStateFlow(0L)
+    val usedBytes: StateFlow<Long> = _bytes
+
+    @Synchronized
+    fun init(context: Context) {
+        if (dir != null) return
+        dir = File(context.applicationContext.filesDir, "tg_offline").also { it.mkdirs() }
+        dir!!.listFiles()?.filter { it.name.endsWith(".part") }?.forEach { it.delete() }
+        refresh()
+    }
+
+    fun fileFor(id: String): File? =
+        dir?.let { File(it, "$id.audio") }?.takeIf { it.exists() && it.length() > 0 }
+
+    private fun refresh() {
+        val files = dir?.listFiles()?.filter { it.name.endsWith(".audio") } ?: emptyList()
+        _ids.value = files.map { it.name.removeSuffix(".audio") }.toSet()
+        _bytes.value = files.sumOf { it.length() }
+    }
+
+    private fun setActive(id: String, percent: Int?) {
+        val m = _active.value.toMutableMap()
+        if (percent == null) m.remove(id) else m[id] = percent
+        _active.value = m
+    }
+
+    fun download(t: TgTrack) {
+        val d = dir ?: return
+        if (fileFor(t.id) != null || jobs.containsKey(t.id)) return
+        setActive(t.id, -1)
+        jobs[t.id] = scope.launch {
+            var tdFileId = 0
+            try {
+                gate.withPermit {
+                    TelegramClient.awaitReady()
+                    val msg = TelegramClient.call(TdApi.GetMessage(t.chatId, t.messageId))
+                    val file = telegramFileOf(msg) ?: error("Not an audio file")
+                    tdFileId = file.id
+                    TelegramClient.call(TdApi.DownloadFile(file.id, 32, 0, 0, false))
+
+                    var lastSize = -1L
+                    var lastChange = System.currentTimeMillis()
+                    while (true) {
+                        val f = TelegramClient.call(TdApi.GetFile(file.id))
+                        val total = maxOf(f.size, f.expectedSize)
+                        val got = f.local.downloadedSize
+                        if (total > 0) setActive(t.id, (got * 100 / total).toInt().coerceIn(0, 99))
+                        if (f.local.isDownloadingCompleted) {
+                            val part = File(d, "${t.id}.part")
+                            File(f.local.path).copyTo(part, overwrite = true)
+                            part.renameTo(File(d, "${t.id}.audio"))
+                            break
+                        }
+                        if (got != lastSize) { lastSize = got; lastChange = System.currentTimeMillis() }
+                        if (System.currentTimeMillis() - lastChange > 60_000) error("Download stalled")
+                        delay(400)
+                    }
+                }
+            } catch (e: CancellationException) {
+                File(d, "${t.id}.part").delete()
+                throw e
+            } catch (e: Exception) {
+                File(d, "${t.id}.part").delete()
+            } finally {
+                if (tdFileId != 0) TelegramClient.deleteLocalFile(tdFileId) // the copy in TDLib's cache is no longer needed
+                jobs.remove(t.id)
+                setActive(t.id, null)
+                refresh()
+            }
+        }
+    }
+
+    fun cancel(id: String) {
+        jobs[id]?.cancel()
+    }
+
+    fun remove(id: String) {
+        cancel(id)
+        dir?.let { File(it, "$id.audio").delete() }
+        refresh()
+    }
+}
+
+/** Keeps the next songs of the queue on the phone so playback never waits on the network. */
+object TelegramPrefetcher {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val fileIds = ConcurrentHashMap<String, Int>()
+    private const val AHEAD = 2
+
+    /** Call when the player moves to a new song. */
+    fun onTransition(player: Player) {
+        val count = player.mediaItemCount
+        if (count == 0) return
+        val cur = player.currentMediaItemIndex
+        val ids = (cur + 1..minOf(cur + AHEAD, count - 1))
+            .map { player.getMediaItemAt(it).mediaId }
+            .filter { TelegramUri.isTelegramId(it) }
+        if (ids.isEmpty()) return
+        scope.launch {
+            ids.forEachIndexed { n, id -> prefetch(id, if (n == 0) 20 else 10) }
+            TelegramClient.trimCache()
+        }
+    }
+
+    private fun prefetch(id: String, priority: Int) {
+        if (TelegramOffline.fileFor(id) != null) return // already stored for offline
+        if (TelegramClient.auth.value != TelegramClient.AuthState.READY) return
+        try {
+            val uri = TelegramUri.uriForSongId(id)
+            val chatId = uri.host!!.toLong()
+            val messageId = uri.pathSegments[0].toLong()
+            val fileId = fileIds.getOrPut(id) {
+                telegramFileOf(TelegramClient.call(TdApi.GetMessage(chatId, messageId)))!!.id
+            }
+            TelegramClient.call(TdApi.DownloadFile(fileId, priority, 0, 0, false))
+        } catch (e: Exception) {
+            // prefetch is best effort
+        }
+    }
+}
