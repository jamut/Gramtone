@@ -0,0 +1,131 @@
+/**
+ * Metrolist Telegram source (experimental)
+ * Licensed under GPL-3.0
+ */
+
+package com.metrolist.music.telegram
+
+import android.content.Context
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import org.drinkless.tdlib.Client
+import org.drinkless.tdlib.TdApi
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/** Thin wrapper over TDLib: auth state, blocking requests, ranged file download. */
+object TelegramClient {
+    enum class AuthState { NOT_STARTED, WAIT_PHONE, WAIT_CODE, WAIT_PASSWORD, READY, ERROR }
+
+    private val _auth = MutableStateFlow(AuthState.NOT_STARTED)
+    val auth: StateFlow<AuthState> = _auth
+
+    private var client: Client? = null
+    private var apiId = 0
+    private var apiHash = ""
+    private lateinit var appContext: Context
+
+    @Synchronized
+    fun start(context: Context, apiId: Int, apiHash: String) {
+        if (client != null) return
+        appContext = context.applicationContext
+        this.apiId = apiId
+        this.apiHash = apiHash
+        Client.execute(TdApi.SetLogVerbosityLevel(1))
+        client = Client.create({ update -> onUpdate(update) }, null, null)
+    }
+
+    /** Restart the saved session after process death (TDLib keeps the login on disk). */
+    fun autoStart(context: Context) {
+        val prefs = context.getSharedPreferences("tg_poc", Context.MODE_PRIVATE)
+        val id = prefs.getString("id", null)?.toIntOrNull() ?: return
+        val hash = prefs.getString("hash", null) ?: return
+        start(context, id, hash)
+    }
+
+    /** Blocks until logged in; used by the player before it reads from Telegram. */
+    fun awaitReady(timeoutSec: Long = 20) {
+        val deadline = System.currentTimeMillis() + timeoutSec * 1000
+        while (_auth.value != AuthState.READY) {
+            if (System.currentTimeMillis() > deadline) error("Telegram not logged in")
+            Thread.sleep(100)
+        }
+    }
+
+    private fun onUpdate(update: TdApi.Object) {
+        if (update is TdApi.UpdateAuthorizationState) {
+            when (update.authorizationState) {
+                is TdApi.AuthorizationStateWaitTdlibParameters -> {
+                    val p = TdApi.SetTdlibParameters()
+                    p.databaseDirectory = appContext.filesDir.absolutePath + "/tdlib"
+                    // Partially downloaded audio lives here; see trimCache().
+                    p.filesDirectory = appContext.cacheDir.absolutePath + "/tdlib_files"
+                    p.databaseEncryptionKey = ByteArray(0)
+                    p.useFileDatabase = true
+                    p.useChatInfoDatabase = true
+                    p.useMessageDatabase = true
+                    p.useSecretChats = false
+                    p.apiId = apiId
+                    p.apiHash = apiHash
+                    p.systemLanguageCode = "en"
+                    p.deviceModel = "Android"
+                    p.systemVersion = android.os.Build.VERSION.RELEASE
+                    p.applicationVersion = "1.0"
+                    client?.send(p, null)
+                }
+                is TdApi.AuthorizationStateWaitPhoneNumber -> _auth.value = AuthState.WAIT_PHONE
+                is TdApi.AuthorizationStateWaitCode -> _auth.value = AuthState.WAIT_CODE
+                is TdApi.AuthorizationStateWaitPassword -> _auth.value = AuthState.WAIT_PASSWORD
+                is TdApi.AuthorizationStateReady -> {
+                    _auth.value = AuthState.READY
+                    trimCache() // drop chunks left over from earlier sessions
+                }
+                is TdApi.AuthorizationStateClosed -> { client = null; _auth.value = AuthState.NOT_STARTED }
+                else -> Unit
+            }
+        }
+    }
+
+    fun submitPhone(phone: String) { client?.send(TdApi.SetAuthenticationPhoneNumber(phone, null), null) }
+    fun submitCode(code: String) { client?.send(TdApi.CheckAuthenticationCode(code), null) }
+    fun submitPassword(pw: String) { client?.send(TdApi.CheckAuthenticationPassword(pw), null) }
+
+    /** Blocking request. Never call on the main thread. */
+    @Suppress("UNCHECKED_CAST")
+    fun <T : TdApi.Object> call(fn: TdApi.Function<T>, timeoutSec: Long = 60): T {
+        val c = client ?: error("Telegram client not started")
+        var result: TdApi.Object? = null
+        val latch = CountDownLatch(1)
+        c.send(fn) { result = it; latch.countDown() }
+        if (!latch.await(timeoutSec, TimeUnit.SECONDS)) error("Telegram request timed out")
+        val r = result
+        if (r is TdApi.Error) error("Telegram error ${r.code}: ${r.message}")
+        return r as T
+    }
+
+    fun listChats(): List<TdApi.Chat> {
+        runCatching { call(TdApi.LoadChats(TdApi.ChatListMain(), 100)) } // 404 when all loaded
+        val ids = call(TdApi.GetChats(TdApi.ChatListMain(), 100)).chatIds
+        return ids.map { call(TdApi.GetChat(it)) }
+    }
+
+    /** Audio messages of a chat, newest first. Pages with getChatHistory (stable API across TDLib versions). */
+    fun listAudio(chatId: Long, maxCount: Int = 200): List<TdApi.Message> {
+        val out = ArrayList<TdApi.Message>()
+        var from = 0L
+        while (out.size < maxCount) {
+            val msgs = call(TdApi.GetChatHistory(chatId, from, 0, 50, false)).messages
+            if (msgs.isEmpty()) break
+            msgs.filterTo(out) { it.content is TdApi.MessageAudio }
+            from = msgs.last().id
+        }
+        return out
+    }
+
+    /** Delete downloaded chunks so Telegram streaming doesn't eat phone storage. */
+    fun trimCache() {
+        // size=0, ttl=0, count=0 -> delete everything older than the 300s immunity window
+        // (so the track currently playing survives).
+        client?.send(TdApi.OptimizeStorage(0L, 0, 0, 300, null, null, null, false, 0), null)
+    }
+}
diff --git a/app/src/main/kotlin/com/metrolist/music/telegram/TelegramDataSource.kt b/app/src/main/kotlin/com/metrolist/music/telegram/TelegramDataSource.kt
new file mode 100644
index 0000000..62aa7ee
--- /dev/null
+++ b/app/src/main/kotlin/com/metrolist/music/telegram/TelegramDataSource.kt
@@ -0,0 +1,155 @@
+/**
+ * Metrolist Telegram source (experimental)
+ * Licensed under GPL-3.0
+ */
+
+package com.metrolist.music.telegram
+
+import android.net.Uri
+import androidx.media3.common.C
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.BaseDataSource
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSpec
+import org.drinkless.tdlib.TdApi
+import java.io.IOException
+import java.io.RandomAccessFile
+
+/** URI format: tg://<chatId>/<messageId> */
+object TelegramUri {
+    const val SCHEME = "tg"
+    const val ID_PREFIX = "tg_" // song ids look like tg_<chatId>_<messageId>
+
+    fun songId(chatId: Long, messageId: Long) = "$ID_PREFIX${chatId}_$messageId"
+    fun isTelegramId(id: String) = id.startsWith(ID_PREFIX)
+
+    /** tg_<chat>_<msg> -> tg://<chat>/<msg>. Chat ids can be negative, so split on the last underscore. */
+    fun uriForSongId(id: String): Uri {
+        val body = id.removePrefix(ID_PREFIX)
+        val i = body.lastIndexOf('_')
+        return Uri.parse("$SCHEME://${body.substring(0, i)}/${body.substring(i + 1)}")
+    }
+}
+
+/**
+ * Streams a Telegram audio file through TDLib by downloading only the byte
+ * range ExoPlayer asks for, so a whole FLAC never has to be stored.
+ */
+@UnstableApi
+class TelegramDataSource : BaseDataSource(/* isNetwork = */ true) {
+    private var currentUri: Uri? = null
+    private var fileId = 0
+    private var fileSize = 0L
+    private var path: String? = null
+    private var raf: RandomAccessFile? = null
+    private var position = 0L
+    private var bytesRemaining = 0L
+    private var opened = false
+    private var availStart = 0L // byte window known to be on disk
+    private var availEnd = 0L
+
+    override fun open(dataSpec: DataSpec): Long {
+        currentUri = dataSpec.uri
+        transferInitializing(dataSpec)
+        try {
+            TelegramClient.awaitReady()
+            val chatId = dataSpec.uri.host!!.toLong()
+            val messageId = dataSpec.uri.pathSegments[0].toLong()
+            val msg = TelegramClient.call(TdApi.GetMessage(chatId, messageId))
+            val file = (msg.content as TdApi.MessageAudio).audio.audio
+            fileId = file.id
+            fileSize = file.size
+        } catch (e: Exception) {
+            throw IOException("Telegram resolve failed: ${e.message}", e)
+        }
+        position = dataSpec.position
+        bytesRemaining =
+            if (dataSpec.length != C.LENGTH_UNSET.toLong()) dataSpec.length
+            else fileSize - position
+        if (bytesRemaining < 0) throw IOException("Position beyond end of file")
+        opened = true
+        transferStarted(dataSpec)
+        return bytesRemaining
+    }
+
+    override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
+        if (length == 0) return 0
+        if (bytesRemaining == 0L) return C.RESULT_END_OF_INPUT
+        val want = minOf(length.toLong(), bytesRemaining).toInt()
+        val available = ensureDownloaded(position, want)
+        val r = raf ?: throw IOException("File not open")
+        r.seek(position)
+        val n = r.read(buffer, offset, minOf(want.toLong(), available).toInt())
+        if (n <= 0) return C.RESULT_END_OF_INPUT
+        position += n
+        bytesRemaining -= n
+        bytesTransferred(n)
+        return n
+    }
+
+    /** Makes sure [pos, pos+want) is on disk; returns how many bytes from pos are readable. */
+    private fun ensureDownloaded(pos: Long, want: Int): Long {
+        if (path != null && pos >= availStart && pos < availEnd) return availEnd - pos
+        val chunk = maxOf(want.toLong(), CHUNK)
+        val f = try {
+            TelegramClient.call(TdApi.DownloadFile(fileId, 32, pos, chunk, true))
+        } catch (e: Exception) {
+            throw IOException("Telegram download failed: ${e.message}", e)
+        }
+        val local = f.local
+        if (path != local.path) {
+            raf?.close()
+            raf = RandomAccessFile(local.path, "r")
+            path = local.path
+        }
+        // downloadedPrefixSize counts from downloadOffset
+        val readable = local.downloadOffset + local.downloadedPrefixSize - pos
+        if (readable <= 0) throw IOException("Telegram returned no data at $pos")
+        availStart = pos
+        availEnd = pos + readable
+        return readable
+    }
+
+    override fun getUri(): Uri? = currentUri
+
+    override fun close() {
+        raf?.close(); raf = null; path = null
+        currentUri = null
+        availStart = 0; availEnd = 0
+        if (opened) { opened = false; transferEnded() }
+    }
+
+    class Factory : DataSource.Factory {
+        override fun createDataSource(): DataSource = TelegramDataSource()
+    }
+
+    /** Routes tg:// to Telegram, everything else to the normal upstream. */
+    class RoutingFactory(private val upstream: DataSource.Factory) : DataSource.Factory {
+        override fun createDataSource(): DataSource = Routing(upstream.createDataSource(), TelegramDataSource())
+    }
+
+    private class Routing(
+        private val default: DataSource,
+        private val telegram: DataSource,
+    ) : DataSource {
+        private var active: DataSource = default
+
+        override fun addTransferListener(l: androidx.media3.datasource.TransferListener) {
+            default.addTransferListener(l); telegram.addTransferListener(l)
+        }
+
+        override fun open(dataSpec: DataSpec): Long {
+            active = if (dataSpec.uri.scheme == TelegramUri.SCHEME) telegram else default
+            return active.open(dataSpec)
+        }
+
+        override fun read(buffer: ByteArray, offset: Int, length: Int) = active.read(buffer, offset, length)
+        override fun getUri() = active.uri
+        override fun getResponseHeaders() = active.responseHeaders
+        override fun close() = active.close()
+    }
+
+    companion object {
+        private const val CHUNK = 512L * 1024
+    }
+}
